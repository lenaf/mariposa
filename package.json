  "version": "0.3.0",
  "author": "Kostas Vrouvas <hello@kosvrouvas.com>",
  "dependencies": {
    "@column-resizer/react": "^1.3.0",
    "@contentful/rich-text-react-renderer": "^16.0.2",
    "@contentful/rich-text-types": "^17.0.1",
    "autoprefixer": "^10.4.7",
    "gatsby": "^5.14.5",
    "gatsby-plugin-breakpoints": "^1.3.11",
    "gatsby-plugin-image": "^3.14.0",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-offline": "^6.14.0",
    "gatsby-plugin-postcss": "^6.14.0",
    "gatsby-plugin-purgecss": "^6.2.1",
    "gatsby-plugin-react-helmet": "^6.14.0",
    "gatsby-plugin-sharp": "^5.14.0",
    "gatsby-source-contentful": "^8.15.0",
    "gatsby-source-filesystem": "^5.14.0",
    "gatsby-transformer-sharp": "^5.14.0",
